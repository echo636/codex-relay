include README.md README.zh-CN.md LICENSE NOTICE THIRD_PARTY_NOTICES.md CHANGELOG.md SECURITY.md CONTRIBUTING.md AGENTS.md
include requirements*.txt pyproject.toml
recursive-include codex_remote/static *
recursive-include deploy *.example
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
prune test-results
prune .browsers
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.map
